          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": 1,\n  \"amount\": 18.50\n}"
            },
            "url": {
              "raw": "http://localhost:8082/internal/payment",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["internal", "payment"]
            },
            "description": "Mock endpoint for the Payment microservice. Succeeds 80% of the time, fails 20%."
          }
        },
        {
          "name": "Mock Kitchen Processing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": 1,\n  \"foodItem\": \"Pepperoni Pizza XL\"\n}"
            },
            "url": {
              "raw": "http://localhost:8083/internal/kitchen",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["internal", "kitchen"]
            },
            "description": "Mock endpoint for the Kitchen microservice. Simulates food preparation and returns FOOD_READY."
          }
        },
        {
          "name": "Mock Delivery Assignment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": 1,\n  \"customerName\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "http://localhost:8084/internal/delivery",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8084",
              "path": ["internal", "delivery"]
            },
            "description": "Mock endpoint for the Delivery microservice. Assigns a courier partner, generates an ETA, and returns DELIVERED."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "admin_token",
      "value": "paste_jwt_token_here",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "paste_camunda_task_id_here",
      "type": "string"
    }
  ]
}
