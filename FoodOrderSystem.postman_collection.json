{
  "info": {
    "_postman_id": "893c59cf-b7c4-4cda-92ee-67ee847d0663",
    "name": "Food Order Processing System API",
    "description": "API collection for testing and verifying the Food Order Processing System microservices.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates the admin user and returns a JWT Bearer Token."
          }
        }
      ]
    },
    {
      "name": "Order Service",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"John Doe\",\n  \"foodItem\": \"Pepperoni Pizza XL\",\n  \"amount\": 18.50\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "orders"]
            },
            "description": "Places a new food order, saves it to the database, and publishes a creation event to ActiveMQ."
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "orders"]
            },
            "description": "Retrieves all placed orders from the system."
          }
        },
        {
          "name": "Get Order Details & Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/orders/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "orders", "1"]
            },
            "description": "Retrieves specific order details along with the associated Camunda workflow execution history logs."
          }
        }
      ]
    },
    {
      "name": "Admin Tasks",
      "item": [
        {
          "name": "Get Active Camunda Tasks",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/admin/tasks",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "admin", "tasks"]
            },
            "description": "Fetches all active Camunda user tasks waiting for Admin approval. Requires Admin JWT bearer token."
          }
        },
        {
          "name": "Complete Task (Approve)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/admin/tasks/{{task_id}}/complete",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "admin", "tasks", "{{task_id}}", "complete"]
            },
            "description": "Approves an order by completing the corresponding Camunda User Task. Resumes workflow orchestration."
          }
        }
      ]
    },
    {
      "name": "Internal Microservices (Mock Endpoints)",
      "item": [
        {
